// ==========================================================================
//  TF2 Custom Font - chatscheme override
//
//  Template generated by tools/dev/build-templates.py.
//  Normal use: run tools/set-font.sh (Linux) or tools\set-font.cmd
//  (Windows) to regenerate this file for another font - no manual
//  editing needed. Marker: TF2_CUSTOM_FONT_OVERRIDE
//
//  Font mapping (see --list-fonts in the scripts):
//  tf2         -> DejaVu Sans (custom)
//  build       -> DejaVu Sans (custom)
//  secondary   -> DejaVu Sans (custom)
//  professor   -> DejaVu Sans (custom)
//  body        -> DejaVu Sans (custom)
//  numbers     -> DejaVu Sans (custom)
//  hud         -> DejaVu Sans (custom)
//
//  Every glyph-set carries // CUSTOMFONT:ORIG=<original family>.
//  Everything except the font names is inherited from
//  "chatscheme_base.res" (vanilla scheme or a custom HUD scheme).
// ==========================================================================

#base "chatscheme_base.res"

Scheme
{
	// CUSTOMFONT:CUSTOM-FILE-BEGIN
	// Registered only when a role uses a custom font file.
	CustomFontFiles
	{
		"1000"
		{
			"font"	"resource/customfont.ttf"
			"name"	"DejaVu Sans"

			// CUSTOMFONT:RANGE-BEGIN
			// The range blocks make the engine use the replacement font for
			// the whole Unicode range instead of falling back to a system font.
			// Remove them (or use --no-range / -NoRange) if the font only has
			// Latin glyphs and you want CJK text to fall back to a system font.
			"english"	{ "range" "0x0000 0xFFFF" }
			"german"	{ "range" "0x0000 0xFFFF" }
			"french"	{ "range" "0x0000 0xFFFF" }
			"italian"	{ "range" "0x0000 0xFFFF" }
			"korean"	{ "range" "0x0000 0xFFFF" }
			"spanish"	{ "range" "0x0000 0xFFFF" }
			"schinese"	{ "range" "0x0000 0xFFFF" }
			"tchinese"	{ "range" "0x0000 0xFFFF" }
			"russian"	{ "range" "0x0000 0xFFFF" }
			"thai"	{ "range" "0x0000 0xFFFF" }
			"japanese"	{ "range" "0x0000 0xFFFF" }
			"portuguese"	{ "range" "0x0000 0xFFFF" }
			"brazilian"	{ "range" "0x0000 0xFFFF" }
			"latam"	{ "range" "0x0000 0xFFFF" }
			"polish"	{ "range" "0x0000 0xFFFF" }
			"danish"	{ "range" "0x0000 0xFFFF" }
			"dutch"	{ "range" "0x0000 0xFFFF" }
			"finnish"	{ "range" "0x0000 0xFFFF" }
			"norwegian"	{ "range" "0x0000 0xFFFF" }
			"swedish"	{ "range" "0x0000 0xFFFF" }
			"czech"	{ "range" "0x0000 0xFFFF" }
			"hungarian"	{ "range" "0x0000 0xFFFF" }
			"romanian"	{ "range" "0x0000 0xFFFF" }
			"turkish"	{ "range" "0x0000 0xFFFF" }
			"bulgarian"	{ "range" "0x0000 0xFFFF" }
			"greek"	{ "range" "0x0000 0xFFFF" }
			"ukrainian"	{ "range" "0x0000 0xFFFF" }
			"vietnamese"	{ "range" "0x0000 0xFFFF" }
			// CUSTOMFONT:RANGE-END
		}
	}
	// CUSTOMFONT:CUSTOM-FILE-END

	Fonts
	{
		// Each glyph-set is replaced according to its original family
		// (CUSTOMFONT:ORIG).  Only the name is written, so tall/weight/
		// antialias/... still come from the base.

		"Default"
		{
			"1"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"2"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"3"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"4"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"5"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
		}

		"ChatFont"
		{
			"1"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"2"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"3"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"4"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
			"5"	{ "name" "DejaVu Sans" }	// CUSTOMFONT:ORIG=Verdana
		}
		// CUSTOMFONT:HUD-FONTS
	}
}
